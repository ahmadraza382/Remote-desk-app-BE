# Copy this file to .env and fill in your local PostgreSQL password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/remotedesk

# Optional: secret for the admin /admin/block and /admin/unblock endpoints.
# If unset, those endpoints are disabled (return 503). Set a strong random value in prod.
ADMIN_TOKEN=

# Environment: 'dev' (default) or 'prod'. dev allows ws:// and falls back to Google STUN
# when coturn is unconfigured; prod enforces TLS and requires coturn for TURN.
APP_ENV=dev

# Self-hosted coturn (STUN + TURN). Leave empty in dev (Google STUN fallback is used).
# In production: TURN_HOST is the coturn host (e.g. turn.example.com) and TURN_SECRET must
# match coturn's `static-auth-secret`. Never commit the real secret.
TURN_HOST=
TURN_SECRET=
